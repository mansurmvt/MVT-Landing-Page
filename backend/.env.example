# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5000

# SMTP Mail Server Configuration (Nodemailer)
# Replace with your actual SMTP credentials (e.g. SendGrid, Mailgun, AWS SES, Gmail, custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@monotonicvector.io
SMTP_PASS=your_super_secret_smtp_password
SMTP_FROM_NAME="Monotonic Vector Technology"
SMTP_FROM_EMAIL=contact@monotonicvector.io

# Target Admin / Inquiries Inbox
INQUIRIES_RECIPIENT_EMAIL=inquiries@monotonicvector.io
